rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function canManageContent() {
      return isAdmin() ||
        (
          isSignedIn() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'president', 'core_team']
        );
    }

    function isStaff() {
      return isAdmin() ||
        (
          isSignedIn() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'president', 'core_team', 'volunteer']
        );
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /team/{memberId} {
      allow read: if true;
      allow write: if canManageContent();
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /tickets/{ticketId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || isStaff()));
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid && 
                    request.resource.data.get('verified', false) == false;
      allow update: if isStaff() ||
                       (
                         isSignedIn() &&
                         resource.data.userId == request.auth.uid &&
                         request.resource.data.userId == request.auth.uid &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'customCertificate'])
                       );
      allow delete: if isStaff();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId &&
                    !request.resource.data.keys().hasAny(['role', 'membershipTier', 'subscriptionStart', 'subscriptionEnd', 'paymentStatus']) &&
                    request.resource.data.get('membershipStatus', 'public') == 'public' &&
                    request.resource.data.get('isFoundingMember', false) == false;
      allow update: if (isSignedIn() && request.auth.uid == userId && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'membershipStatus', 'isFoundingMember', 'membershipTier', 'subscriptionStart', 'subscriptionEnd', 'paymentStatus']) &&
                       (
                         request.resource.data.get('points', 0) == resource.data.get('points', 0) ||
                         (request.resource.data.get('points', 0) == resource.data.get('points', 0) + 20 && !resource.data.get('profileCompletedRewarded', false) && request.resource.data.get('profileCompletedRewarded', false)) ||
                         (request.resource.data.get('points', 0) == resource.data.get('points', 0) + 5) ||
                         ((request.resource.data.get('points', 0) == resource.data.get('points', 0) + 3 || request.resource.data.get('points', 0) == resource.data.get('points', 0) + 5) && request.resource.data.get('answeredBlogs', []).size() == resource.data.get('answeredBlogs', []).size() + 1)
                       )) ||
                       (isSignedIn() && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points']) &&
                        request.resource.data.get('points', 0) == resource.data.get('points', 0) + 20) ||
                       isStaff();
      allow delete: if isStaff() || (isSignedIn() && request.auth.uid == userId);
    }

    match /blogs/{blogId} {
      allow read: if resource.data.status == 'approved' ||
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        isStaff();
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        (request.resource.data.status == 'pending' || isStaff());
      allow update: if isStaff() ||
        (
          isSignedIn() &&
          resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.status == 'pending'
        ) ||
        (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['engagementScore']) &&
          (request.resource.data.engagementScore == resource.data.get('engagementScore', 0) + 1 || request.resource.data.engagementScore == resource.data.get('engagementScore', 0) + 5)
        );
      allow delete: if isStaff() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if canManageContent();
    }
    


    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid || isStaff();
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.get('status', 'pending') == 'pending' &&
                    request.resource.data.get('paymentStatus', 'pending') == 'pending';
      allow update, delete: if isStaff();
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    match /team_applications/{appId} {
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid && 
                    request.resource.data.get('status', 'pending') == 'pending';
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow update, delete: if isStaff();
    }

    match /workshopProposals/{proposalId} {
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid && 
                    request.resource.data.get('status', 'pending') == 'pending';
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow update, delete: if isStaff();
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create, delete: if canManageContent();
      allow update: if isSignedIn();
    }

    match /merchandise/{merchId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /certificateTemplates/{templateId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isStaff();
    }
  }
}
